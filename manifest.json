{
  "manifest_version": 3,
  "name": "Flying Lyrics - Romanize Your Lyrics",
  "short_name": "FlyingLyrics",
  "version": "5.0",
  "description": "A floating extension for synchronized lyrics, romanization, and translations to sing along while multitasking.",
  "browser_specific_settings": {
    "gecko": {
      "id": "flying-lyrics@kalek.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "technicalAndInteraction"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": [
      "src/background/storage.js",
      "src/background/analytics.js",
      "src/background/romanizer.js",
      "src/background/search/sanitizer.js",
      "src/background/search/scoring.js",
      "src/background/search/network.js",
      "src/background/search/providers/lrclib.js",
      "src/background/search/providers/netease.js",
      "src/background/search/providers/kugou.js",
      "src/background/searchEngine.js",
      "src/background/background.js"
    ]
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "host_permissions": [
    "https://lrclib.net/*",
    "https://translate.googleapis.com/*",
    "https://i.scdn.co/*",
    "https://music.163.com/*",
    "https://*.spotifycdn.com/*",
    "https://www.google-analytics.com/*",
    "https://api.mymemory.translated.net/*",
    "https://*.kugou.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.ggpht.com/*",
    "https://*.ytimg.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://open.spotify.com/*",
        "*://music.youtube.com/*"
      ],
      "js": [
        "src/content/mainWorldHook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://open.spotify.com/*",
        "*://music.youtube.com/*"
      ],
      "js": [
        "src/background/storage.js",
        "src/background/romanizer.js",
        "src/content/config.js",
        "src/content/content.js",
        "src/content/content/statsTracker.js",
        "src/content/content/messageRouter.js",
        "src/content/selectors.js",
        "src/content/utils.js",
        "src/content/services/lrcParser.js",
        "src/content/services/lyricsCache.js",
        "src/content/services/translator.js",
        "src/content/services/metadataHelper.js",
        "src/content/content/messageUtils.js",
        "src/content/services.js",
        "src/content/ui/colorPalette.js",
        "src/content/ui/domBuilder.js",
        "src/content/ui/launcher.js",
        "src/content/ui.js",
        "src/content/pipDrivers.js",
        "src/content/renderer/effects.js",
        "src/content/renderer/layout.js",
        "src/content/renderer/emptyStateQuotes.js",
        "src/content/renderer/pipBadge.js",
        "src/content/renderer/pipSync.js",
        "src/content/renderer/textDrawer.js",
        "src/content/renderer.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/styles.css",
        "src/content/inject.js",
        "src/content/mainWorldHook.js",
        "assets/icons/icon.png"
      ],
      "matches": [
        "*://open.spotify.com/*",
        "*://music.youtube.com/*"
      ]
    }
  ]
}